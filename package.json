{
  "name": "splyce-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/splyce-pi",
    "apps/desktop"
  ],
  "scripts": {
    "build:contracts": "tsc -p packages/splyce-pi/tsconfig.json",
    "test:contracts": "node scripts/run-contracts.mjs",
    "test:gui-fixtures": "node --test tests/gui-fixtures.test.mjs",
    "test:engine-store": "node --test tests/engine-store.test.mjs",
    "test:store-contract": "node scripts/run-store.mjs --case J0_store_contract",
    "test:receipts-cursor": "node scripts/run-store.mjs --case C1_reconnect_cursor",
    "test:desktop-bridge": "node scripts/run-store.mjs --case C2_desktop_bridge",
    "test:config-transition": "node scripts/run-store.mjs --case C4_config_transition",
    "test:release-gate": "npm run test:contracts && npm run test:store-contract && npm run test:receipts-cursor && npm run test:desktop-bridge && npm run test:config-transition && npm run test:gui-fixtures && npm run test:engine-store && npm run test:desktop",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \".skills/**/*.md\" \".github/**/*.md\" \"#node_modules\"",
    "check:docs": "python scripts/check_docs.py",
    "test:docs": "python -m unittest tests/test_check_docs.py",
    "test:desktop": "npm run check --workspace=@splyce/desktop && npm run test --workspace=@splyce/desktop"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "katex": "0.18.11"
  },
  "license": "AGPL-3.0-only"
}
