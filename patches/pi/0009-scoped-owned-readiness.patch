+
+export function assertSameSplyceOwner(parent: object, child: object, expectedRole?: SplyceRole): void {
+	const a = current(parent);
+	const b = current(child);
+	if (a.owner !== b.owner || (expectedRole && b.role !== expectedRole)) unavailable();
+}
